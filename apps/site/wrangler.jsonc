// apps/site as a Cloudflare Worker (apps/site ADR-0001), one Worker per Site:
// deploy with `wrangler deploy --name pm-<slug>` so every fork keeps this file
// as it is. `pnpm worker:build && pnpm worker:dev` runs the OpenNext build on
// workerd locally, with the vars from .dev.vars.
//
// HYPERDRIVE pools connections to the database every Site shares (ADR-0005);
// the app reads its connection string on Workers (src/database.ts). `id` is
// the Hyperdrive config (payload-cms-sites, in the Tech@vrobx.com account) for
// the neondb database of Neon project payload-cms-sites (spring-salad-55976645),
// over its direct, unpooled host: Hyperdrive pools. One for all Sites.
// Locally, wrangler connects straight to `localConnectionString` instead.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awayday-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a4a923b598e84c2ca3b55f109ffb1c44",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/property_management_sites",
    },
  ],
}
