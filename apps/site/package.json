{
  "name": "site",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:build": "opennextjs-cloudflare build",
    "worker:dev": "wrangler dev --port 8787",
    "lint": "eslint --max-warnings 0 && tsx scripts/check-migrations.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "genericize": "tsx scripts/genericize-migration.ts",
    "site": "tsx scripts/site.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@workspace/ui": "workspace:*",
    "graphql": "^16.14.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.3",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.143.0"
  }
}
