{
  "name": "site",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:build": "opennextjs-cloudflare build",
    "worker:dev": "wrangler dev --port 8787",
    "lint": "eslint --max-warnings 0 && tsx scripts/check-migrations.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "genericize": "tsx scripts/genericize-migration.ts",
    "site": "tsx scripts/site.ts",
    "seed": "tsx scripts/seed.ts",
    "sites:worktrees": "tsx scripts/sites-worktrees.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/link": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@workspace/ui": "workspace:*",
    "graphql": "^16.14.2",
    "jose": "^6.2.12",
    "lexical": "0.50.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.3",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/node": "4.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "jsdom": "^30.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.143.0"
  }
}
