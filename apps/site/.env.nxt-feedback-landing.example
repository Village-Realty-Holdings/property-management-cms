# NXT Vacation guest feedback page: env for `pnpm site nxt-feedback-landing <command>` (apps/site ADR-0005).
#
#   cp apps/site/.env.nxt-feedback-landing.example apps/site/.env.nxt-feedback-landing
#   pnpm site nxt-feedback-landing migrate     # creates the "nxt_feedback_landing" schema and its tables
#   pnpm site nxt-feedback-landing dev         # http://localhost:3005/admin
#
# .env.nxt-feedback-landing is gitignored; keep secrets there, not in this template.
# Variables already set in your shell win over this file, except
# DATABASE_SCHEMA, SITE_URL and PORT, which always come from here.

# Postgres connection string. All Sites can share one database: each one
# keeps its tables in its own schema.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_management_sites

# This Site's Postgres schema. `migrate` creates it if it is missing. The
# local Media folder is media/nxt_feedback_landing/ and S3/R2 keys start nxt_feedback_landing/.
DATABASE_SCHEMA=nxt_feedback_landing

# Where this Site is served, without a trailing slash. The domain lives here,
# not in the Brand.
SITE_URL=http://localhost:3005

# Port for `next dev` and `next start`: 3001 Warren Beach, 3002 Avada,
# 3003 Beachside, 3005 NXT feedback landing.
PORT=3005

# Secret that signs Staff sessions and Payload tokens: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Dev sign-in (apps/site ADR-0003). Only outside production.
DEV_SIGN_IN=1

# Staff sign-in with Microsoft Entra ID (apps/site ADR-0003).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Media object storage (R2 or any S3-compatible store). Leave all empty to
# keep uploads on local disk in apps/site/media/nxt_feedback_landing.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Where the survey's feedback goes: the Awayday Workflows platform's origin.
# The Site posts each submission to <WORKFLOWS_URL>/api/run/<workflow>, and
# that workflow emails guest care. Empty, a guest who sends feedback is told
# it could not be sent.
WORKFLOWS_URL=
# Optional. The workflow's id; defaults to guest-feedback-survey.
GUEST_FEEDBACK_WORKFLOW=
