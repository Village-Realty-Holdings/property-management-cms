# Warren Beach: env for `pnpm site warren-beach <command>` (apps/site ADR-0005).
#
#   cp apps/site/.env.warren-beach.example apps/site/.env.warren-beach
#   pnpm site warren-beach migrate     # creates the "warren_beach" schema and its tables
#   pnpm site warren-beach dev         # http://localhost:3001/admin
#
# .env.warren-beach is gitignored; keep secrets there, not in this template.
# Variables already set in your shell win over this file, except
# DATABASE_SCHEMA, SITE_URL and PORT, which always come from here.

# Postgres connection string. All Sites can share one database: each one
# keeps its tables in its own schema.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_management_sites

# This Site's Postgres schema. `migrate` creates it if it is missing. The
# local Media folder is media/warren_beach/ and S3/R2 keys start warren_beach/.
DATABASE_SCHEMA=warren_beach

# Where this Site is served, without a trailing slash. The domain lives here,
# not in the Brand.
SITE_URL=http://localhost:3001

# Port for `next dev` and `next start`: 3001 Warren Beach, 3002 Avada,
# 3003 Beachside.
PORT=3001

# Secret that signs User sessions and Payload tokens: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Dev sign-in (apps/site ADR-0003). Only outside production.
DEV_SIGN_IN=1

# User sign-in with Microsoft Entra ID (apps/site ADR-0003).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Media object storage (R2 or any S3-compatible store). Leave all empty to
# keep uploads on local disk in apps/site/media/warren_beach.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
