# apps/site reads its env through Next.js from apps/site/.env.
# (For several Sites use one file each, see .env.<slug>.example.)
#
#   cp apps/site/.env.example apps/site/.env
#   docker compose up -d postgres
#   docker compose exec postgres createdb -U postgres property_management_sites
#   pnpm --filter site dev          # then open http://localhost:3000/admin

# Postgres connection string (docker-compose.yml runs Postgres 17 on :5432).
# Integration tests create and drop throwaway `pm_test_*` databases on this server.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_management_sites

# Secret that signs User sessions and Payload tokens: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Dev sign-in (apps/site ADR-0003): "1" shows "Dev sign-in" in the Admin and
# answers GET /auth/dev with a session for dev@awayday.test. Only outside
# production; the app refuses to start in production with this set.
DEV_SIGN_IN=1

# User sign-in with Microsoft Entra ID (apps/site ADR-0003): the Site's app
# registration (confidential client, so the secret is required). "Sign in with
# Microsoft" is hidden and /auth/entra/* answer 404 while the tenant, client
# id or secret is empty. Redirect URI: <origin>/auth/entra/callback.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional. Defaults to <request origin>/auth/entra/callback.
ENTRA_REDIRECT_URI=
# Optional issuer override (tests / a local mock issuer). Defaults to
# https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0
ENTRA_ISSUER=
# Optional. The app role a Microsoft account needs to sign in at all, and the
# ID token claim listing app roles. Default to bds_campaign_user and roles.
AUTH_REQUIRED_ROLE=
AUTH_ROLE_CLAIM=

# Media object storage: Cloudflare R2 through its S3 API, or any
# S3-compatible store. Leave all empty to keep uploads on local disk in
# apps/site/media.
S3_BUCKET=
# e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# "auto" for R2.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (R2 custom domain), without a trailing slash.
S3_PUBLIC_URL=

# Postgres schema for this Site (apps/site ADR-0005): one deployment per Site,
# Sites can share a database. `payload migrate` creates the schema if it is
# missing. Unset means "public", which is what tests use, so leave it unset
# in a shell that runs `pnpm test`. The local Media folder is
# media/<schema>/ and S3/R2 keys start <schema>/.
# To run one of the three Sites use `pnpm site <slug> <command>` with its own
# env file instead (.env.warren-beach.example, .env.avada.example,
# .env.beachside.example).
# DATABASE_SCHEMA=warren_beach

# The Site's public origin, without a path. Used for absolute URLs in
# sitemap.xml, robots.txt, canonical links and Open Graph. Optional in
# development (defaults to http://localhost:3000); required in production,
# where the app throws when it is unset or not an http(s) origin.
SITE_URL=http://localhost:3000

# Where the Guest feedback survey Block's feedback goes: the Awayday Workflows
# platform's origin, without a path. The Site posts each submission to
# <WORKFLOWS_URL>/api/run/<GUEST_FEEDBACK_WORKFLOW>, and that workflow emails
# guest care. Leave empty and a guest who sends feedback is told it could not
# be sent.
WORKFLOWS_URL=
# Optional. The workflow's id; defaults to guest-feedback-survey.
GUEST_FEEDBACK_WORKFLOW=
