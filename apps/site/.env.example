# One Site deployment serves exactly one Site (ADR-0010). Copy to .env.local.

# The Site's slug: must equal the `slug` of its Site record in the CMS.
# With CONTENT_ADAPTER=fake: demo-mountain or demo-beach.
SITE=demo-mountain

# Where content comes from: "rest" (default) reads the CMS over REST;
# "fake" serves in-memory demo content and needs no CMS.
CONTENT_ADAPTER=fake

# CMS base URL, e.g. http://localhost:3000. Required with CONTENT_ADAPTER=rest.
CMS_URL=http://localhost:3000

# The Site's SiteReader API key (CMS: Site Readers). Read-only, this Site only.
# Required with CONTENT_ADAPTER=rest.
CMS_READER_KEY=

# Must equal the Site record's revalidation secret in the CMS. Authenticates
# POST /api/revalidate (Bearer token).
REVALIDATION_SECRET=

# Optional: public base URL of the R2/S3 bucket serving editorial Media, as
# configured on the CMS. Allowed as a next/image source.
S3_PUBLIC_URL=
