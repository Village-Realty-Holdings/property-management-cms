{
  "name": "property-management",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=site",
    "dev:cms": "turbo dev --filter=property-management-cms",
    "build": "turbo build --filter=site",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "turbo lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter site generate:types && pnpm --filter site generate:importmap",
    "migrate": "pnpm --filter site migrate",
    "migrate:create": "pnpm --filter site migrate:create",
    "worker:build": "pnpm --filter site worker:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
