{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "property-management-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "property-management-cms",
      "database_id": "e5fde511-d252-4236-9bbc-c195823b3cbb",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "property-management-cms-media",
    },
  ],
  // Lets `next/image` resize through Cloudflare Images instead of sharp.
  // see https://opennext.js.org/cloudflare/howtos/image
  "images": {
    "binding": "IMAGES",
  },
  // Non-secret runtime variables. Secrets (PAYLOAD_SECRET, PREVIEW_SECRET,
  // CRON_SECRET) are set with `npx wrangler secret put <NAME>`.
  // Local overrides live in `.dev.vars` (gitignored).
  "vars": {
    // Warren Beach is the first tenant; its domains are added to the Worker as
    // Custom Domains in the dashboard (Workers > Settings > Domains & Routes).
    "NEXT_PUBLIC_SERVER_URL": "https://warrenbeachrentals.com",
    // Tenant slug served when no tenant `domains` entry matches the hostname
    // (e.g. the workers.dev preview URL).
    "DEFAULT_TENANT": "warren-beach",
  },
}
