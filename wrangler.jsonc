{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "property-management-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "property-management-cms",
      // Paste the id printed by `pnpm wrangler d1 create property-management-cms`
      "database_id": "DATABASE_ID",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "property-management-cms-media",
    },
  ],
  // Lets `next/image` resize through Cloudflare Images instead of sharp.
  // see https://opennext.js.org/cloudflare/howtos/image
  "images": {
    "binding": "IMAGES",
  },
  // Non-secret runtime variables. Secrets (PAYLOAD_SECRET, PREVIEW_SECRET,
  // CRON_SECRET) are set with `pnpm wrangler secret put <NAME>`.
  // Local overrides live in `.dev.vars` (gitignored).
  "vars": {
    "NEXT_PUBLIC_SERVER_URL": "https://property-management-cms.workers.dev",
  },
}
