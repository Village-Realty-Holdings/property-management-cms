# apps/cms reads its env through Next.js from apps/cms/.env (not this file).
# Copy it there and fill in real values:
#
#   cp .env.example apps/cms/.env
#   docker compose up -d postgres
#   docker compose exec postgres createdb -U postgres property_management_cms

# Postgres connection string (docker-compose.yml runs Postgres 17 on :5432).
# Integration tests create and drop throwaway `pm_test_*` databases on this server.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_management_cms

# Secret used to sign Payload tokens. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Break-glass Super Admin, created on startup only when the CMS has no users.
# Nothing is created while either value is empty. Use a strong random password.
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD=

# Media object storage (ADR-0008): Cloudflare R2 through its S3 API, or any
# S3-compatible store (e.g. MinIO in dev). Leave all empty to keep uploads on
# local disk in apps/cms/media. Files are stored as <siteSlug>/<filename>.
S3_BUCKET=
# e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# "auto" for R2.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (R2 custom domain), without a trailing slash.
S3_PUBLIC_URL=

# Days a Submission (guest personal data) is kept: sets its retainUntil date.
# Default 365.
SUBMISSION_RETENTION_DAYS=365

# Staff sign-in with Microsoft Entra ID (ADR-0016): the CMS's own app
# registration (confidential client, app roles cms_user / cms_super_admin).
# "Sign in with Microsoft" is hidden and /auth/entra/* answer 404 while the
# tenant, client id or secret is empty. There is no dev bypass.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional. Defaults to <request origin>/auth/entra/callback.
ENTRA_REDIRECT_URI=
# Optional issuer override (tests / a local mock issuer). Defaults to
# https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0
ENTRA_ISSUER=

# Property Feed the Sync reads from. "fake" uses the in-memory demo feed
# (accounts demo-mountain and demo-beach; see apps/cms/src/sync/fixtures).
# Anything else uses the HTTP Feed, which answers 501 until its contract exists.
PROPERTY_FEED=
